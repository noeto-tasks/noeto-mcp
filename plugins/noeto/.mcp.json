{
  "noeto": {
    "command": "docker",
    "args": [
      "run", "-i", "--rm",
      "-e", "NOETO_TOKEN",
      "-e", "NOETO_API_URL",
      "-e", "NOETO_DOWNLOAD_DIR=${NOETO_DOWNLOAD_DIR:-/tmp/noeto-attachments}",
      "-v", "${NOETO_DOWNLOAD_DIR:-/tmp/noeto-attachments}:${NOETO_DOWNLOAD_DIR:-/tmp/noeto-attachments}",
      "ghcr.io/noeto-tasks/noeto-mcp:v0.6.1"
    ]
  }
}
