{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.noeto-tasks/noeto-mcp",
  "title": "Noeto",
  "description": "Work a Noeto kanban board: read and search it, create, move and comment on cards, keep docs on them.",
  "websiteUrl": "https://noeto.online/docs/ai-agent/",
  "repository": {
    "url": "https://github.com/noeto-tasks/noeto-mcp",
    "source": "github"
  },
  "version": "0.6.3",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/noeto-tasks/noeto-mcp:v0.6.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NOETO_TOKEN",
          "description": "Personal access token, from Settings → Access tokens in Noeto. It decides which team the server works.",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "placeholder": "noeto_pat_…"
        },
        {
          "name": "NOETO_API_URL",
          "description": "The Noeto API root.",
          "isRequired": true,
          "format": "string",
          "default": "https://api.noeto.online/api/v1"
        }
      ]
    }
  ]
}
